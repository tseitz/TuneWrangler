# Required for Phase 1 (playlist extraction via SoundCloud API)
TUNEWRANGLER_SC_PLAYLIST_URL=https://soundcloud.com/your-username/sets/your-playlist
SOUNDCLOUD_CLIENT_ID=your_client_id
SOUNDCLOUD_CLIENT_SECRET=your_client_secret

# SoundCloud identity / download prompt values (Phase 2)
TUNEWRANGLER_SC_EMAIL=your@email.com
TUNEWRANGLER_SC_NAME=YourName
TUNEWRANGLER_SC_COMMENT=🔥🔥🔥

# ── Phase 2: Chrome bring-up (CDP attach) ─────────────────────────────────────
# Path to real Chrome binary. Default works on macOS.
# Linux/Windows users must set this explicitly.
# TUNEWRANGLER_SC_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Dedicated Chrome profile dir (isolated from your daily-driver Chrome).
# Default: <repo root>/soundcloud_dl_chrome_profile
# TUNEWRANGLER_SC_CHROME_PROFILE_DIR=

# CDP debug port. Override if you have a port conflict.
# TUNEWRANGLER_SC_CHROME_DEBUG_PORT=9222

# Directory where downloaded files are saved. Leave unset to skip saving.
# TUNEWRANGLER_SC_DOWNLOAD_DIR=~/Downloads/SoundCloud

# ── Phase 2: pacing ───────────────────────────────────────────────────────────
# Random pause between actions (ms) and per-keystroke fill delay (ms).
# TUNEWRANGLER_SC_ACTION_DELAY_MIN_MS=300
# TUNEWRANGLER_SC_ACTION_DELAY_MAX_MS=900
# TUNEWRANGLER_SC_TYPE_DELAY_MS=80
# TUNEWRANGLER_SC_DELAY_SECONDS=3
# TUNEWRANGLER_SC_PAGE_LOAD_WAIT=3
# TUNEWRANGLER_SC_SCROLL_BEFORE_CLICK=1

# ── Resume / cache ────────────────────────────────────────────────────────────
# Skip already-done track URLs on re-runs (logs/soundcloud_dl_processed.json). Default: 1.
# TUNEWRANGLER_SC_RESUME=1
# Reuse cached playlist track lists (logs/soundcloud_dl_playlist_cache.json). Default: 1.
# TUNEWRANGLER_SC_PLAYLIST_CACHE=1
