{
  "files.exclude": {
    "node_modules": true
  },

  // All Python here runs through `uv run --project soundcloud_dl`, so nothing
  // depends on an activated venv. Left on, the Python extension re-discovers
  // soundcloud_dl/.venv every time uv touches it and types `source .../activate`
  // into whatever terminal is focused, mid-command.
  "python.terminal.activateEnvironment": false,

  "deno.enable": true
}
