{
  "compilerOptions": {
    "lib": ["deno.ns", "deno.window"]
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "node-id3": "npm:node-id3@^0.2.9",
    "@typesafe-ai/sdk": "npm:@typesafe-ai/sdk@^0.6.0",
    "youtube": "https://deno.land/x/youtube@v0.3.0/mod.ts"
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read --allow-write src/ tests/",
    "promote": "deno run --allow-env --allow-read --allow-write scripts/promote.ts",
    "validate": "deno run --allow-env --allow-read src/config/validate.ts",
    "rM": "deno run -A --env-file src/processors/renameMusic.ts",
    "rBc": "deno run -A src/processors/renameBandcamp.ts",
    "rI": "deno run -A src/processors/renameItunes.ts",
    "rBp": "deno run -A src/processors/renameBeatport.ts",
    "ytRb": "deno run -A src/processors/addM3uToYoutubePlaylist.ts",
    "playlistImport": "deno run -A src/processors/betterM3uSearch.ts",
    "cF": "deno run -A src/processors/convertFlacs.ts",
    "cli": "deno run -A --env-file src/cli/main.ts",
    "py": "uv run --project soundcloud_dl soundcloud-dl",
    "py:test": "uv run --project soundcloud_dl pytest soundcloud_dl/tests/",
    "py:check": "uv run --project soundcloud_dl ty check soundcloud_dl/soundcloud_dl",
    "py:lint": "uv run --project soundcloud_dl ruff check soundcloud_dl/soundcloud_dl",
    "py:fmt": "uv run --project soundcloud_dl ruff format soundcloud_dl/soundcloud_dl",
    "py:fmt:check": "uv run --project soundcloud_dl ruff format --check soundcloud_dl/soundcloud_dl"
  }
}
