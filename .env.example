# TuneWrangler environment configuration
# Copy this file to .env at the repo root and customize for your system.
# All paths default to platform-specific values in src/config/paths.ts —
# only set the variables for paths you want to override.

# ──────────────────────────────────────────────────────────────────────────────
# Main tool (Deno) — TUNEWRANGLER_*_PATH
# ──────────────────────────────────────────────────────────────────────────────

# Source folder for `deno task rM`
TUNEWRANGLER_DOWNLOADED_PATH=/Users/yourname/Music/Downloaded/

# DJ collection (used for duplicate detection)
TUNEWRANGLER_DJMUSIC_PATH=/Users/yourname/DJ/Collection/

# Destination for renamed files (apply mode moves files here)
TUNEWRANGLER_RENAME_PATH=/Users/yourname/Music/Renamed/

# Source files are backed up here before being moved
TUNEWRANGLER_BACKUP_PATH=/Users/yourname/Music/Backup/

# Per-source rename folders
TUNEWRANGLER_BANDCAMP_PATH=/Users/yourname/Music/Bandcamp/
TUNEWRANGLER_ITUNES_PATH=/Users/yourname/Music/iTunes/Music

# Other folders
TUNEWRANGLER_MUSIC_PATH=/Users/yourname/Music/
TUNEWRANGLER_DOWNLOADS_PATH=/Users/yourname/Downloads/
TUNEWRANGLER_YOUTUBE_PATH=/Users/yourname/Music/Youtube/
TUNEWRANGLER_DJPLAYLISTS_PATH=/Users/yourname/DJ/Playlists/
TUNEWRANGLER_DJPLAYLISTIMPORT_PATH=/Users/yourname/DJ/Playlists/Import/
TUNEWRANGLER_TRANSFER_PATH=/Users/yourname/Music/Transfer/

# ──────────────────────────────────────────────────────────────────────────────
# soundcloud_dl (Python) — TUNEWRANGLER_SC_*
# ──────────────────────────────────────────────────────────────────────────────

# Required: SoundCloud playlist URL to process
TUNEWRANGLER_SC_PLAYLIST_URL=https://soundcloud.com/yourname/sets/your-playlist

# Required: SoundCloud API credentials (register an app at soundcloud.com/you/apps)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Only if the app registers a different one. Must match the app's setting exactly, and
# must be a localhost URI with a port so --sc-auth can catch the redirect.
SOUNDCLOUD_REDIRECT_URI=http://localhost:8080/callback

# Form values used by gate handlers
TUNEWRANGLER_SC_EMAIL=you@example.com
TUNEWRANGLER_SC_NAME=YourName
TUNEWRANGLER_SC_COMMENT=🔥🔥🔥

# Optional: download directory for browser-triggered downloads
TUNEWRANGLER_SC_DOWNLOAD_DIR=/Users/yourname/Music/Downloaded/soundcloud

# Optional: Chrome bring-up
# TUNEWRANGLER_SC_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# TUNEWRANGLER_SC_CHROME_DEBUG_PORT=9222
# TUNEWRANGLER_SC_CHROME_PROFILE_DIR=    # defaults to soundcloud_dl_chrome_profile/ in repo

# Optional: timing tuning
# TUNEWRANGLER_SC_DELAY_SECONDS=3
# TUNEWRANGLER_SC_PAGE_LOAD_WAIT=3
# TUNEWRANGLER_SC_ACTION_DELAY_MIN_MS=300
# TUNEWRANGLER_SC_ACTION_DELAY_MAX_MS=900
# TUNEWRANGLER_SC_TYPE_DELAY_MS=80

# Optional: feature toggles (1=enabled, 0=disabled)
# TUNEWRANGLER_SC_RESUME=1               # skip URLs already processed
# TUNEWRANGLER_SC_PLAYLIST_CACHE=1       # cache API responses
# TUNEWRANGLER_SC_HEADED=                # 1 to show the browser window
# TUNEWRANGLER_SC_SCROLL_BEFORE_CLICK=1

# ──────────────────────────────────────────────────────────────────────────────
# Optional: TypeSafe judgment pilot (soundcloud-dl --jev)
# ──────────────────────────────────────────────────────────────────────────────
TYPESAFE_API_KEY=
